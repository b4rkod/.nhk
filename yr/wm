	 chmod +x /usr/bin/omni
	 mkdir -p ~/.config/polybar/
	 mkdir -p ~/.config/dmenu-frecency/ 
	 cp -rv $NHKCFG/dmenu-frecency.config.json ~/.config/dmenu-frecency/config.json
	 mkdir -p ~/.config/dunst/
	 cp -rv $NHKCFG/dunstrc ~/.config/dunst/
	 mkdir -p ~/.config/hints/
	 cp -rv $NHKCFG/config.hints.json ~/.config/hints/config.json
	 mkdir -p ~/.config/warpd/
	 cp -rv $NHKCFG/warpd.config ~/.config/warpd/config 
	 mkdir -p ~/.config/sxhkd && cp -rv $NHK/xk/* ~/.config/sxhkd/
	 cd $NHK
	 mkdir -p ~/.config/mimi 
	 cp -rv $NHKCFG/mimi.conf ~/.config/mimi/mime.conf
	 mkdir -p ~/.local/bin 
	 cp -rv xt/foxtag ~/.local/bin/
	 cp -rv xt/wiconv ~/.local/bin/
         cp -rv xt/slmenu ~/.local/bin/
	 cp -rv $NHKCFG/.Xresources_nhk $HOME/
	 xrdb -merge ~/.Xresources_nhk
	 git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
	 cp -rv $NHKCFG/.nhktx.conf ~/
	 tmux source-file ~/.nhktx.conf
	 cd $NHK/src
         sudo make clean install
	 sudo mkdir -p /usr/share/xsessions/ 
	 sudo cp -rv $NHK/src/nhk.desktop /usr/share/xsessions/
	 sudo chmod +x patch/dwmc
	 sudo cp -rv patch/dwmc /usr/bin/dwmc
	 cd $NHK
         ;;

   -q)
         QRY=$(echo -e "w\nwq\nq" | dmenu -i -fn $FONT -nb black -nf white -sb white -sf black -p "::")
	 case $QRY in
		 "w")
		    $TRM -hold -cd $NHK/src -e sh -c "sudo make clean install && sudo mkdir -p /usr/share/xsessions/ && sudo cp -rv nhk.desktop /usr/share/xsessions/"
		    ;;

		  "wq")
		    $TRM -hold -cd $NHK/src -e sh -c "sudo make clean install && sudo mkdir -p /usr/share/xsessions/ && sudo cp -rv nhk.desktop /usr/share/xsessions/"
		    sleep 1
		    dwmc quit
		    ;;

	          "q")
		    dwmc quit 
		    ;;
	 esac
	 ;;

   -EE)

     if [[ $# -gt 1 ]]; then
	$TXT "${@:2}" 
     else 
	$TXT $NHK/yr/wm && sudo cp -rv $NHK/yr/wm .local/bin/wm
     fi

     ;;

    *)
	echo "
	wm 0.1 - nhk window management and configuration tool.
	EE: edit wm directly.
	pk/upk: (re)package/unpackage nhk-related configurations.	
	q: rebuild or simply quit dwm. 
	T: view nhk documentation.
	------------------------------
	ss: screenshotting function.
	sv: screen recording function.
	ar: audio recording function.
	------------------------------
	b: nhk metabrowser (metanet).
	c: open instant messenger.
	M: interact with email client.
	g: git management tool.
	d: display management tool.
	w: wallpaper setter (0.1 - nitrogen --restore).
	K: kanata management tool (0.1 - initializes kanata daemon).
	"
	;;
	
esac 
