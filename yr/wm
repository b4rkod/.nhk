	    "em")
	        EM=$(echo -e "snd\nrcv" | dmenu -i -fn $FONT -nb black -nf white -sb white -sf black -p "::em")
	        case "$EM" in
	            snd)
	                SEND=$(echo "" | dmenu -i -fn $FONT -nb black -nf white -sb white -sf black -p "->")
	                $IX mailto:"$SEND"
	                ;;
	            rcv)
	                RECV=$(echo -e "acc\nmx" | dmenu -i -fn $FONT -nb black -nf white -sb white -sf black -p "<-")
	                case "$RECV" in
	                    acc)
	                        ACC=$(echo "" | dmenu -i -fn $FONT -nb black -nf white -sb white -sf black -p "::acc")
	                        $IX -a $ACC
	                        ;;
	                    mx)
	                        MX=$(dmenufm -t -p)
	                        $IX -e mbox:"$MX"
	                        ;;
